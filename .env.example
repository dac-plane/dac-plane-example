# Configuration of apps/server. Copy to .env (never committed) and fill in.
# The values below address the local dac-plane stack started with `just stack-up`
# in a dac-plane checkout; its generated settings are in that checkout's
# .work/stack/compose.env.

# Where this server listens.
HOST=127.0.0.1
PORT=3000

# The Surface API origin and the one tenant this application works in.
DAC_SURFACE_URL=https://dac-plane:8443
DAC_TENANT=01a167fd-51d9-76ba-b563-496e2bd89646

# Providers a new agent defaults to. dac-plane's Surface API cannot list them
# yet (dac-plane#156); these are the local stack's simulated providers.
DAC_RUNTIME_PROVIDER_ID=01a167fd-51d9-7d22-8a3b-6c5d4e3f2a10
DAC_ENVIRONMENT_PROVIDER_ID=01a167fd-51d9-7d44-8a3b-6c5d4e3f2a12

# The service principal's client credentials at the issuer. The secret is read
# from a file, never from the environment.
DAC_TOKEN_URL=https://issuer:8443/default/token
DAC_CLIENT_ID=surface-owner
DAC_CLIENT_SECRET_FILE=/path/to/dac-plane/.work/stack/surface-client-secret
DAC_SCOPE=dac-plane-surface

# The deployment's private CA, when it has one.
DAC_CA_FILE=/path/to/dac-plane/.work/stack/ca.pem

# Dial another address for an origin while still checking its certificate
# name, like curl --connect-to. The local stack publishes on loopback ports.
DAC_CONNECT_TO=issuer:8443=127.0.0.1:18080,dac-plane:8443=127.0.0.1:18443
